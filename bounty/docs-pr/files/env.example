# KeeperHub environment template
# Copy to .env and fill in. Lines marked [self-hosting] only matter when running
# the platform yourself; CLI/MCP users typically need just the first block.
#
# DRAFT NOTE (remove before merging): variable names below the first block were
# drafted from the hosted product's observable surface — verify each against the
# repo's config loader and delete anything that doesn't exist.

# ── Using KeeperHub (CLI / MCP / API) ────────────────────────────────────────
# Org API key. Mint at app.keeperhub.com → avatar → API Keys.
# Creation requires BOTH an email code and a TOTP code — have your authenticator ready.
KH_API_KEY=kh_your_key_here

# API base. Default is the hosted platform; point at your own deployment when self-hosting.
# MCP endpoint is ${KH_API_URL}/mcp (Streamable HTTP — see docs/self-hosting-troubleshooting.md).
KH_API_URL=https://app.keeperhub.com

# ── [self-hosting] Core services ─────────────────────────────────────────────
# TODO(verify): confirm exact names against the config loader.
DATABASE_URL=postgres://keeperhub:password@localhost:5432/keeperhub
REDIS_URL=redis://localhost:6379

# ── [self-hosting] Auth ──────────────────────────────────────────────────────
# TODO(verify): session/JWT secret and OAuth client credentials.
AUTH_SECRET=generate_a_long_random_string

# ── [self-hosting] Chain access ──────────────────────────────────────────────
# RPC endpoints per supported chain (execution chains: Ethereum, Sepolia, ...).
# TODO(verify): naming scheme (per-chain vars vs. JSON map).
ETH_MAINNET_RPC_URL=
ETH_SEPOLIA_RPC_URL=

# ── [self-hosting] Wallet infrastructure (Turnkey) ───────────────────────────
# Org wallets are Turnkey-managed; gas sponsorship runs through the Turnkey Gas Station.
# TODO(verify): exact credential variable names.
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=
